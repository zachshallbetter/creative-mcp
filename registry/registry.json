{
  "$schema": "./registry.schema.json",
  "schema": 1,
  "series": "creative-mcp",
  "author": "Zach Shallbetter",
  "updated": "2026-11-03",
  "tools": [
    {
      "id": "adobe",
      "name": "Adobe MCP",
      "summary": "Local MCP servers for InDesign, Illustrator, Photoshop, After Effects and Premiere Pro, with a coordinator for two documented cross-app workflows.",
      "repo": "https://github.com/zachshallbetter/adobe-mcp",
      "docs": "https://creativemcp.com/apps.html",
      "license": "MIT",
      "author": "Zach Shallbetter",
      "status": "Tested",
      "version": "0.3.0",
      "language": "Node.js 18+",
      "site": {
        "page": "/apps.html",
        "event": "cta_adobe_mcp",
        "mark": "/brand-symbol.svg",
        "tone": "purple",
        "parts": "five app servers, Suite coordinator, shared core",
        "bullets": [
          "Five application-specific implementations",
          "One suite coordinator for two documented cross-app workflows",
          "Node.js 18+, macOS or Windows"
        ],
        "fact": "five app-specific Node.js servers (Node.js 18+, macOS or Windows) plus a Suite coordinator for two documented Illustrator-to-InDesign workflows. npm: `adobe-mcp-suite`.",
        "setup_note": "Registers the Adobe MCP coordinator, which provides two Illustrator-to-InDesign workflows. To use an app's own tools, register its server too (adobe-mcp-photoshop and so on), or let creative-mcp setup pick the servers that match your apps.",
        "readiness": [
          "Node.js 18 or later is installed (Homebrew installs it for you).",
          "The Adobe app you want to use is installed on this computer.",
          "Your MCP client can launch local stdio servers.",
          "You know which project folders the server should be allowed to access."
        ]
      },
      "install": {
        "brew": { "formula": "zachshallbetter/tap/adobe-mcp" },
        "npm": { "package": "adobe-mcp-suite" }
      },
      "requires": ["node>=18"],
      "servers": [
        { "command": "adobe-mcp-suite", "role": "coordinator", "register_as": "adobe", "requires_apps": ["illustrator", "indesign"] },
        { "command": "adobe-mcp-indesign", "app": "indesign", "register_as": "indesign", "status": "indesign_status" },
        { "command": "adobe-mcp-illustrator", "app": "illustrator", "register_as": "illustrator", "status": "illustrator_status" },
        { "command": "adobe-mcp-photoshop", "app": "photoshop", "register_as": "photoshop", "status": "photoshop_status" },
        { "command": "adobe-mcp-aftereffects", "app": "aftereffects", "register_as": "aftereffects", "status": "aftereffects_status" },
        { "command": "adobe-mcp-premiere", "app": "premiere", "register_as": "premiere", "status": "premiere_status" }
      ],
      "targets": [
        { "app": "indesign", "name": "Adobe InDesign",
          "detect": { "macos": { "bundle_ids": ["com.adobe.InDesign"], "verified": false },
                     "windows": { "globs": ["C:/Program Files/Adobe/Adobe InDesign */InDesign.exe"], "verified": false } } },
        { "app": "illustrator", "name": "Adobe Illustrator",
          "detect": { "macos": { "bundle_ids": ["com.adobe.illustrator"], "verified": true },
                     "windows": { "globs": ["C:/Program Files/Adobe/Adobe Illustrator */Support Files/Contents/Windows/Illustrator.exe"], "verified": false } } },
        { "app": "photoshop", "name": "Adobe Photoshop",
          "detect": { "macos": { "bundle_ids": ["com.adobe.Photoshop"], "verified": true },
                     "windows": { "globs": ["C:/Program Files/Adobe/Adobe Photoshop */Photoshop.exe"], "verified": false } } },
        { "app": "aftereffects", "name": "Adobe After Effects",
          "detect": { "macos": { "bundle_ids": ["com.adobe.AfterEffects.application"], "verified": true },
                     "windows": { "globs": ["C:/Program Files/Adobe/Adobe After Effects */Support Files/AfterFX.exe"], "verified": false } } },
        { "app": "premiere", "name": "Adobe Premiere Pro",
          "detect": { "macos": { "bundle_id_prefixes": ["com.adobe.PremierePro"], "verified": false },
                     "windows": { "globs": ["C:/Program Files/Adobe/Adobe Premiere Pro */Adobe Premiere Pro.exe"], "verified": false } } }
      ],
      "try": [
        "With Photoshop open: what documents are open, and what layers does the active one have?",
        "In Illustrator, make a 1080×1080 artboard with a centred circle in the brand colour #7444D8.",
        "In After Effects, list the compositions in this project with their duration and frame rate."
      ],
      "clients": ["claude-code", "claude-desktop", "codex", "cursor", "gemini"]
    },
    {
      "id": "blender",
      "name": "Blender MCP",
      "summary": "A Rust MCP server and companion Blender add-on for scenes, objects, materials and 3D asset pipelines.",
      "repo": "https://github.com/zachshallbetter/blender-mcp-rs",
      "docs": "https://creativemcp.com/docs/implementations/blender.html",
      "license": "MIT OR Apache-2.0",
      "author": "Zach Shallbetter",
      "status": "Implemented",
      "version": "0.5.1",
      "language": "Rust",
      "register_command": "blender-mcp client add {client}",
      "site": {
        "page": "/docs/implementations/blender.html",
        "event": "cta_blender_mcp",
        "mark": "/assets/logos/blender.svg",
        "tone": "orange",
        "parts": "Rust server, CLI and Blender add-on",
        "bullets": [
          "Stdio MCP server with local Blender IPC",
          "Blender 4.0+ and the companion add-on"
        ],
        "fact": "a Rust MCP server and CLI with a companion Blender add-on (Blender 4.0+); `blender-mcp addon install` installs and turns on the add-on.",
        "setup_note": "Installs the CLI, lets it install and turn on the companion add-on (quit Blender first), then registers the local server with your client. Blender MCP requires Blender 4.0 or later.",
        "readiness": [
          "Homebrew is installed (or Rust and Cargo, to build from source).",
          "Blender 4.0 or later is installed.",
          "Blender is closed while you run blender-mcp addon install, so it can turn the add-on on for you.",
          "Your MCP client can launch local stdio servers."
        ]
      },
      "install": {
        "brew": { "formula": "zachshallbetter/tap/blender-mcp" },
        "cargo": { "git": "https://github.com/zachshallbetter/blender-mcp-rs", "package": "blender-mcp-cli" }
      },
      "requires": [],
      "servers": [
        { "command": "blender-mcp", "args": ["serve"], "app": "blender", "register_as": "blender", "status": "get_addon_status" }
      ],
      "post_install": ["blender-mcp addon install"],
      "checks": ["blender-mcp addon status"],
      "try": [
        "With Blender open: list the objects in the current scene and their materials.",
        "Add a low-poly rock at the origin, give it a rough grey material and frame it in the camera."
      ],
      "targets": [
        { "app": "blender", "name": "Blender",
          "detect": { "macos": { "bundle_ids": ["org.blenderfoundation.blender"], "min_version": "4.0", "verified": true },
                     "windows": { "globs": ["C:/Program Files/Blender Foundation/Blender */blender.exe"], "verified": false },
                     "linux": { "commands": ["blender"], "verified": false } } }
      ],
      "clients": ["claude-code", "codex", "cursor", "gemini", "antigravity"]
    }
  ],
  "clients": [
    { "id": "claude-code", "name": "Claude Code", "detect": { "commands": ["claude"],
      "paths": ["~/.claude/local/claude", "~/.local/bin/claude", "~/Library/Application Support/Claude/claude-code/*/*/claude.app/Contents/MacOS/claude"],
      "files": ["~/.claude.json"] } },
    { "id": "claude-desktop", "name": "Claude Desktop", "restart": "Quit Claude Desktop (⌘Q) and open it again", "detect": { "files": ["~/Library/Application Support/Claude/claude_desktop_config.json", "~/AppData/Roaming/Claude/claude_desktop_config.json"] } },
    { "id": "codex", "name": "Codex", "detect": { "commands": ["codex"], "files": ["~/.codex/config.toml"] } },
    { "id": "cursor", "name": "Cursor", "restart": "Restart Cursor, or reload its window", "detect": { "commands": ["cursor"], "files": ["~/.cursor/mcp.json"] } },
    { "id": "gemini", "name": "Gemini CLI", "detect": { "commands": ["gemini"], "files": ["~/.gemini/settings.json"] } },
    { "id": "antigravity", "name": "Google Antigravity", "restart": "Restart Antigravity", "detect": { "commands": ["antigravity"] } }
  ]
}
